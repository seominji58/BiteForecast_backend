# 복사해서 .env 로 사용: cp .env.example .env
# .env 는 git 에 올리지 않는다 (NFR-03)

APP_ENV=dev
DATABASE_URL=sqlite:///./biteforecast.db

# 공공데이터포털(data.go.kr) 인증키 하나로 국립해양조사원(물때·부이·바다낚시지수)과 기상청(단기예보·특보)을 받는다
DATA_GO_KR_API_KEY=
# 기상청 API허브 인증키 (현재 사용 안 함)
KMA_API_KEY=
# 경기데이터드림(data.gg.go.kr) OpenAPI 인증키 — 경기도 낚시어선업 현황. 서버에서만 쓴다 (앱 EXPO_PUBLIC_ 에 넣지 않음)
GYEONGGI_DATA_API_KEY=

# 사진 인증 관리자 검토 화면(/api/v1/admin) 비밀값. 비우면 관리자 기능이 막힌다
# 만들기: python3 -c "import secrets;print(secrets.token_urlsafe(24))"
ADMIN_TOKEN=
# 업로드 사진 저장 폴더 (git 제외)
MEDIA_DIR=./media

# 포인트 하루 상한 (0 = 미적용, 명세 D-7)
POINT_DAILY_CAP=0

# 외부 API 호출 설정 (NFR-04)
EXTERNAL_TIMEOUT_SECONDS=5
EXTERNAL_RETRIES=2

# 구글 로그인: 구글 클라우드 콘솔 OAuth 클라이언트 ID (웹·iOS·Android, 쉼표로 구분). 비우면 구글 로그인 버튼이 숨겨짐
GOOGLE_CLIENT_IDS=
# 로그인 유지 기간(일). 마지막 사용 후 이 기간이 지나면 다시 로그인
SESSION_DAYS=60
