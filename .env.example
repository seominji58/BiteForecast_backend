# 복사해서 .env 로 사용: cp .env.example .env
# .env 는 git 에 올리지 않는다 (NFR-03)

APP_ENV=dev
DATABASE_URL=sqlite:///./biteforecast.db

# 공공데이터포털(data.go.kr) 인증키: 국립해양조사원 조석예보·조위관측소·해양관측부이 공통
# 기상청 API허브(apihub.kma.go.kr) 인증키는 KMA_API_KEY
DATA_GO_KR_API_KEY=
KMA_API_KEY=

# 포인트 하루 상한 (0 = 미적용, 명세 D-7)
POINT_DAILY_CAP=0

# 외부 API 호출 설정 (NFR-04)
EXTERNAL_TIMEOUT_SECONDS=5
EXTERNAL_RETRIES=2
